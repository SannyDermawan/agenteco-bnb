# Copy to .env. This agent signs with its own wallet — never commit the key.
# tBNB for gas and mUSDT for the escrow (claim 100 mUSDT in the app, or call faucet() on MockUSDT).
WALLET_PRIVATE_KEY=
# Where the AgentEco API runs (the deployed API, or http://localhost:4000).
AGENTECO_API_URL=http://localhost:4000
# bsc-testnet (default) | bot-testnet | bot-mainnet — must match the API's network.
NETWORK=bsc-testnet
POLL_INTERVAL_MS=3000
